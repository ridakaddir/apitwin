# Binaries (Go build output at project root)
/apitwin
/mokr
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go build cache
*.test
*.out
coverage.out
coverage.html
/dist/

# Log files
*.log

# Dependency directories
vendor/

# Environment
.env
.env.*
!.env.example

# Task cache
.task/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Record mode output — stubs and routes captured at runtime should not be committed
# unless you explicitly want to check them in.
examples/record-mode/recorded.toml
examples/record-mode/stubs/

# openapi-generate example — generated output (regenerate with: apitwin generate ...)
examples/openapi-generate/mocks/
examples/openapi-generate/mocks-yaml/
examples/openapi-generate/mocks-single/

# Any local apitwin config and stubs at the project root (from --init runs)
/apitwin.toml
/apitwin.yaml
/apitwin.yml
/apitwin.json
/stubs/

# Devtool UI build output and dependencies
# NOTE: ui/dist/index.html is tracked (placeholder for go:embed to compile
# without a prior UI build). The hashed JS/CSS bundles in assets/ are ignored.
/ui/node_modules/
/ui/dist/assets/

# VitePress docs build output and dependencies
/website/node_modules/
/website/.vitepress/dist/
/website/.vitepress/cache/
# VitePress builds .md content from /docs/, but Vite/Rollup walks up from each
# .md file looking for node_modules. We satisfy that with a symlink that
# points back into /website/node_modules — recreated by `pnpm prebuild` /
# `pnpm predev`. Never tracked in git.
/docs/node_modules
