{
  "name": "@ridakaddir/apitwin-docs",
  "version": "1.0.0",
  "description": "Documentation site for apitwin - A fast, zero-dependency CLI tool for mocking, stubbing, and proxying HTTP and gRPC APIs",
  "private": true,
  "type": "module",
  "scripts": {
    "link-deps": "node -e \"const fs=require('fs'),p=require('path');const t=p.resolve('../docs/node_modules');try{fs.lstatSync(t)}catch{fs.symlinkSync('../website/node_modules',t,process.platform==='win32'?'junction':'dir')}\"",
    "predev": "pnpm link-deps",
    "prebuild": "pnpm link-deps",
    "prepreview": "pnpm link-deps",
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "packageManager": "pnpm@9.0.0"
}